rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeMember(coupleId) {
      let couplePath = /databases/(default)/documents/couples/$(coupleId);
      return signedIn() && firestore.exists(couplePath) &&
        firestore.get(couplePath).data.status == 'active' &&
        request.auth.uid in firestore.get(couplePath).data.members;
    }
    function validImage() {
      return request.resource != null && request.resource.contentType.matches('image/.*') && request.resource.size <= 30 * 1024 * 1024;
    }
    function validVideo() {
      return request.resource != null && request.resource.contentType.matches('video/.*') && request.resource.size <= 100 * 1024 * 1024;
    }
    match /users/{uid}/private/{mediaId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid && fileName in ['original', 'thumbnail.jpg'];
      allow create, update: if signedIn() && request.auth.uid == uid && fileName in ['original', 'thumbnail.jpg'] &&
        ((fileName == 'thumbnail.jpg' && request.resource.contentType == 'image/jpeg' && request.resource.size <= 2 * 1024 * 1024) ||
          (fileName == 'original' && (validImage() || validVideo())));
      allow delete: if signedIn() && request.auth.uid == uid && fileName in ['original', 'thumbnail.jpg'];
    }
    match /couples/{coupleId}/shared/{uid}/{mediaId}/{fileName} {
      allow read: if activeMember(coupleId) && fileName in ['original', 'thumbnail.jpg'];
      allow create, update: if activeMember(coupleId) && request.auth.uid == uid && fileName in ['original', 'thumbnail.jpg'] &&
        ((fileName == 'thumbnail.jpg' && request.resource.contentType == 'image/jpeg' && request.resource.size <= 2 * 1024 * 1024) ||
          (fileName == 'original' && (validImage() || validVideo())));
      allow delete: if activeMember(coupleId) && request.auth.uid == uid && fileName in ['original', 'thumbnail.jpg'];
    }
  }
}
