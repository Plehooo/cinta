{
  "name": "galeri-cinta-firebase-rules",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/rules.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-galeri-cinta --only firestore,storage \"npm test\"",
    "build:functions": "npm --prefix functions install && npm --prefix functions run build"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^12.4.0",
    "firebase-tools": "^14.0.0"
  }
}
